# WhatsApp session directory (absolute path outside project to persist across redeploys)
WHATSAPP_SESSION_DIR=/home/user/whatsapp-session
# WHATSAPP_SESSION_DIR=/home/yabain/public_html/uploads/whatsapp-session/wha1

# Puppeteer executable path (optional, defaults to bundled Chromium)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# PUPPETEER_EXECUTABLE_PATH=/home/yabain/.cache/puppeteer/chrome/linux-146.0.7680.31/chrome-linux64/chrome

# Auto-initialize WhatsApp client on startup
WHATSAPP_AUTO_INIT=true

# Ready watchdog timeout in ms (default: 90000)
# WHATSAPP_READY_TIMEOUT_MS=90000
  

# WhatsApp Gateway authentication password
WHATSAPP_GATEWAY_PASSWORD=your-secure-password

# Default country code for local phone numbers
WHATSAPP_DEFAULT_COUNTRY_CODE=237

# Expected digit count for local phone numbers (without country code)
# If a number has this many digits, it will be prefixed with the default country code
WHATSAPP_LOCAL_DIGITS=9
